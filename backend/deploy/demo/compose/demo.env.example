# Tenant .env for the public demo workspace (used with production.yml +
# demo.override.yml). Copy to demo.env, fill in the <...> values, chmod 600.

SUBDOMAIN=demo
POSTGRES_USER=moimio
POSTGRES_PASSWORD=<long random string>
POSTGRES_DB=moimio
SECRET_KEY=<64 random hex characters: openssl rand -hex 32>
CORS_ORIGINS=https://demo.example.org
LOG_LEVEL=INFO

# Sign-ups per minute per visitor address on the public form (v1.0.7+).
RATE_LIMIT_REGISTRATION=10

# ── Mail: everything goes to the Mailpit container, nowhere else ──
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=demo
SMTP_PASSWORD=demo
SMTP_FROM_EMAIL=noreply@demo.example.org
SMTP_FROM_NAME=Moimio Demo
SMTP_TLS=false
SMTP_SSL=false

# ── Demo workspace ──
FEATURE_DEMO_NOTICE=true
MOIMIO_DEMO_MAIL_URL=https://demo.example.org/mail/

# ── Capabilities ──
FEATURE_ALLOCATION=true
# Off: no Webhooks page, and no event.created / event.allocated signals to
# the control plane (visitors would otherwise trigger them all day).
FEATURE_OUTBOUND_WEBHOOKS=false
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
FEATURE_CREATE_EVENT_CONFIRMATION=false
FEATURE_ACCOUNT_PORTAL=false
ACCOUNT_URL=
MOIMIO_PARTICIPANT_CAP=

# Required by production.yml even when webhooks are off. With
# FEATURE_OUTBOUND_WEBHOOKS=false the app never registers or calls this URL.
MOIMIO_TENANT_ID=demo
MOIMIO_WEBHOOK_URL=https://control-plane.invalid/unused
MOIMIO_WEBHOOK_SECRET=<any random string>
